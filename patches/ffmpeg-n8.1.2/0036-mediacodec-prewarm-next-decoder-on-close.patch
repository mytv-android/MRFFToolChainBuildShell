@@ -450,12 +451,19 @@ static av_cold int mediacodec_decode_init(AVCodecContext *avctx)
 
     s->ctx->delay_flush = s->delay_flush;
     s->ctx->use_ndk_codec = s->use_ndk_codec;
+    s->ctx->warm_codec = s->warm_codec && avctx->codec_type == AVMEDIA_TYPE_VIDEO;
 
     if ((ret = ff_mediacodec_dec_init(avctx, s->ctx, codec_mime, format)) < 0) {
         s->ctx = NULL;
         goto done;
     }
 
+    /* 关闭时要用这份 format 给下一个流预热实例，所有权交给解码上下文 */
+    if (s->ctx->warm_ready) {
+        s->ctx->warm_format = format;
+        format = NULL;
+    }
+
     av_log(avctx, AV_LOG_INFO,
            "MediaCodec started successfully: codec = %s, ret = %d\n",
            s->ctx->codec_name, ret);
@@ -600,6 +608,8 @@ static const AVOption ff_mediacodec_vdec_options[] = {
                    OFFSET(use_ndk_codec), AV_OPT_TYPE_BOOL, {.i64 = -1}, -1, 1, VD },
     { "operating_rate", "The desired operating rate that the codec will need to operate at, zero for unspecified",
             OFFSET(operating_rate), AV_OPT_TYPE_INT, {.i64 = 0}, 0, INT_MAX, VD },
+    { "warm_codec", "On close, prewarm a fresh decoder with the same name, surface and format for the next stream",
+                    OFFSET(warm_codec), AV_OPT_TYPE_BOOL, {.i64 = 1}, 0, 1, VD },
     { NULL }
 };
 

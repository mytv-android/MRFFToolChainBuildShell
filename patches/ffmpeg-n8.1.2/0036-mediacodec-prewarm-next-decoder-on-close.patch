+++ b/libavcodec/mediacodecdec.c
@@ -59,6 +59,7 @@ typedef struct MediaCodecH264DecContext {
     int use_ndk_codec;
     // Ref. MediaFormat KEY_OPERATING_RATE
     int operating_rate;
+    int warm_codec;
 } MediaCodecH264DecContext;
 

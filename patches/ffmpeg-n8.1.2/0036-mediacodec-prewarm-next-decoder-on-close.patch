+/*
+ * init 时调用：领走同一输出目标上、参数相同的预热实例。领不到返回 NULL；预热实例占着
+ * 同一个 Surface 但参数不符时，同步删掉它，让新实例能 configure 到这个 Surface 上。
+ */
+static FFAMediaCodec *mediacodec_warm_take(AVCodecContext *avctx, MediaCodecDecContext *s,
+                                           const char *mime, int profile)
+{
+    ANativeWindow *window = mediacodec_warm_window(s->surface, avctx);
+    MediaCodecWarm *w = NULL;
+    FFAMediaCodec *codec = NULL;
+    int64_t t0 = av_gettime_relative();
+
+    if (!window)
+        return NULL;
+
+    pthread_mutex_lock(&mc_warm_mutex);
+    /* 预热线程还在跑：它马上要占同一个 Surface，必须等它收尾再决定 */
+    mediacodec_warm_wait_locked();
+    if (mc_warm && mc_warm->window == window) {
+        w = mc_warm;
+        mc_warm = NULL;
     }
-    entry->next = mc_pool;
-    mc_pool = entry;
-    mc_pool_count++;

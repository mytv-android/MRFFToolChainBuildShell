+static pthread_mutex_t mc_warm_mutex = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t mc_warm_cond = PTHREAD_COND_INITIALIZER;
+static int mc_warm_pending;         /* 还在跑的预热线程数 */

+/* 领用预热实例后，新流的 SPS/PPS 要在第一个包之前当 codec-config 送进去。 */
+static void mediacodec_warm_prepare_csd(MediaCodecDecContext *s, FFAMediaFormat *format)
+{
+    void *csd[2] = { NULL, NULL };
+    size_t size[2] = { 0, 0 };
+    static const char *const keys[2] = { "csd-0", "csd-1" };
+
+    for (int i = 0; i < 2; i++) {
+        /* 长度为 0 时 JNI 版给的是 Java 缓冲的直接地址，不是我们的内存，不能释放 */
+        if (!ff_AMediaFormat_getBuffer(format, keys[i], &csd[i], &size[i]) || !csd[i] || !size[i]) {
+            csd[i] = NULL;
+            size[i] = 0;
+        }
+    }
+    if (size[0] + size[1] > 0) {
+        s->pending_csd = av_malloc(size[0] + size[1]);
+        if (s->pending_csd) {
+            if (size[0])
+                memcpy(s->pending_csd, csd[0], size[0]);
+            if (size[1])
+                memcpy(s->pending_csd + size[0], csd[1], size[1]);
+            s->pending_csd_size = size[0] + size[1];
+        }
+    }
+    /* JNI 版 getBuffer 返回的是拷贝，NDK 版返回 format 内部指针 */
+    if (!s->use_ndk_codec) {
+        av_free(csd[0]);
+        av_free(csd[1]);
+    }
 }
 

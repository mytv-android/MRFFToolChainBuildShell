+const char *av_mediacodec_get_selected_codec_name(AVCodecContext *avctx)
+{
+    MediaCodecH264DecContext *s;
+
+    if (!avctx || !avctx->priv_data || !avctx->codec || !avctx->codec->name)
+        return NULL;
+    if (!strstr(avctx->codec->name, "mediacodec"))
+        return NULL;
+    s = avctx->priv_data;
+    return s->ctx ? s->ctx->codec_name : NULL;

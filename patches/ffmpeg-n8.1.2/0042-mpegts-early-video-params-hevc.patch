+int ff_hevc_decode_sps(HEVCSPSInfo *info, const uint8_t *buf, int buf_size)
+{
+    HEVCDecoderConfigurationRecord hvcc;
+    HVCCNALUnit nal = { 0 };
+    GetBitContext gb;
+    uint8_t *rbsp, nal_type, nuh_layer_id;
+    uint32_t rbsp_size;
+    int ret;
+
+    memset(info, 0, sizeof(*info));
+    info->sar             = (AVRational){ 0, 1 };
+    info->color_range     = AVCOL_RANGE_MPEG;
+    info->color_primaries = AVCOL_PRI_UNSPECIFIED;
+    info->color_trc       = AVCOL_TRC_UNSPECIFIED;
+    info->colorspace      = AVCOL_SPC_UNSPECIFIED;
+
+    if (buf_size < 3)
+        return AVERROR_INVALIDDATA;
+    rbsp = ff_nal_unit_extract_rbsp(buf, buf_size, &rbsp_size, 2);
+    if (!rbsp)
+        return AVERROR(ENOMEM);
+    ret = init_get_bits8(&gb, rbsp, rbsp_size);
+    if (ret < 0)
+        goto end;
+
+    nal_unit_parse_header(&gb, &nal_type, &nuh_layer_id);
+    if (nal_type != HEVC_NAL_SPS || nuh_layer_id) {
+        ret = AVERROR_INVALIDDATA;
+        goto end;
+    }
+
+    hvcc_init(&hvcc);
+    hvcc.sps_info = info;
+    ret = hvcc_parse_sps(&gb, &nal, &hvcc);
+    hvcc_close(&hvcc);
+    if (ret < 0)
+        goto end;
+    if (get_bits_left(&gb) < 0 || !info->width || !info->height) {
+        ret = AVERROR_INVALIDDATA;
+        goto end;
+    }
+    info->profile_idc = hvcc.general_profile_idc;
+    info->level_idc   = hvcc.general_level_idc;
+    /* like libavcodec: profile_idc 0 falls back to the first compatible profile */
+    for (int i = 1; !info->profile_idc && i < 32; i++)
+        if (hvcc.general_profile_compatibility_flags & (1U << (31 - i)))
+            info->profile_idc = i;
+
+end:
+    av_free(rbsp);
+    return ret;
+}

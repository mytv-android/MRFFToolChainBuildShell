 libavcodec/mediacodecdec_common.c | 170 ++++++++++++++++--------------
 libavcodec/mediacodecdec_common.h |   6 +-
 3 files changed, 114 insertions(+), 81 deletions(-)

diff --git a/libavcodec/mediacodecdec.c b/libavcodec/mediacodecdec.c
index 615398f..e32ad43 100644
--- a/libavcodec/mediacodecdec.c
+++ b/libavcodec/mediacodecdec.c
@@ -60,6 +60,7 @@ typedef struct MediaCodecH264DecContext {
     // Ref. MediaFormat KEY_OPERATING_RATE
     int operating_rate;
     int warm_codec;
+    int stall_warned;
 } MediaCodecH264DecContext;
 
 static av_cold int mediacodec_decode_close(AVCodecContext *avctx)
@@ -527,8 +528,22 @@ static int mediacodec_receive_frame(AVCodecContext *avctx, AVFrame *frame)
                  * return EAGAIN, which violate the design.
                  */
                 if (ff_AMediaCodec_infoTryAgainLater(s->ctx->codec, index) &&
-                    ret == AVERROR(EAGAIN))
-                    continue;
+                    ret == AVERROR(EAGAIN)) {
+                    /* 但不能一直在这里转：解码器卡死（输入口满、一帧不出）时，调用方的解码线程
+                     * 永远回不到自己的循环里看退出请求，停止播放要 join 这条线程，整个应用跟着卡死。
+                     * 上面那次 receive 已经阻塞等了 OUTPUT_DEQUEUE_BLOCK_TIMEOUT_US，到这里
+                     * 还是两头都不动就把 EAGAIN 交回调用方，由它决定继续等还是退出。 */
+                    if (!s->stall_warned) {
+                        s->stall_warned = 1;
+                        av_log(avctx, AV_LOG_WARNING,
+                               "mediacodec stalled: no input buffer and no output frame (codec %s, prewarmed %d)\n",
+                               s->ctx->codec_name, s->ctx->warm_reused);
+                        /* 领来的预热实例卡住了：本进程不再预热，别让下一个台再踩 */
+                        if (s->ctx->warm_reused)
+                            ff_mediacodec_dec_warm_disable();
+                    }
+                    return AVERROR(EAGAIN);
+                }
                 return ret;
             }
             s->ctx->current_input_buffer = index;

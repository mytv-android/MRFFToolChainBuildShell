+/*
+ * 取 format 里的 csd-0 + csd-1 拼成一块（*out 由调用方 av_free），*size0 是 csd-0 的长度。
+ * 没有 csd 时 *out 为 NULL、长度为 0。
+ */
+static int mediacodec_format_csd(FFAMediaFormat *format, int use_ndk_codec,
+                                 uint8_t **out, int *size, int *size0)
+{
+    void *csd[2] = { NULL, NULL };
+    size_t len[2] = { 0, 0 };
+    static const char *const keys[2] = { "csd-0", "csd-1" };
+    int ret = 0;
+
+    *out = NULL;
+    *size = *size0 = 0;
+    for (int i = 0; i < 2; i++) {
+        /* 长度为 0 时 JNI 版给的是 Java 缓冲的直接地址，不是我们的内存，不能释放 */
+        if (!ff_AMediaFormat_getBuffer(format, keys[i], &csd[i], &len[i]) || !csd[i] || !len[i]) {
+            csd[i] = NULL;
+            len[i] = 0;
+        }
+    }
+    if (len[0] + len[1] > 0) {
+        *out = av_malloc(len[0] + len[1]);
+        if (*out) {
+            if (len[0])
+                memcpy(*out, csd[0], len[0]);
+            if (len[1])
+                memcpy(*out + len[0], csd[1], len[1]);
+            *size = len[0] + len[1];
+            *size0 = len[0];
+        } else {
+            ret = AVERROR(ENOMEM);
+        }
+    }
+    /* JNI 版 getBuffer 返回的是拷贝，NDK 版返回 format 内部指针 */
+    if (!use_ndk_codec) {
+        av_free(csd[0]);
+        av_free(csd[1]);
+    }
+    return ret;
+}

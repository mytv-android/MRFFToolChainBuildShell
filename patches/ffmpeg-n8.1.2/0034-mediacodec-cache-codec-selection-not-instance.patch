Content-Transfer-Encoding: 8bit

换台时贵的是 ff_AMediaCodecList_getCodecNameByType()：JNI 里要把所有
MediaCodecInfo 逐个翻一遍，毫秒级；MediaCodec 实例本身创建很便宜。

原来的复用池把实例本身搬给下一个源用，实例身上挂着输入输出缓冲、Surface
绑定、AImageReader 图像槽位和厂商内部状态。遇到一个硬解解不出帧又不报错的
源（喂进去的包全被吞掉），这些状态一起被带进后续会话，之后同 Surface 的
解码器连换编码都解不出画面，只能强杀应用。

改成只缓存 (mime, profile) -> 解码器名，实例每次 configure/start 都新建。
缓存的实例名失效时（组件换了 .so、系统装了新解码器）丢掉重查一次。

顺带去掉因此变成死代码的 unusable / session_inputs / session_outputs。

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
---
 libavcodec/mediacodecdec_common.c | 320 ++++++++++--------------------
 libavcodec/mediacodecdec_common.h |   8 +-
 2 files changed, 113 insertions(+), 215 deletions(-)

diff --git a/libavcodec/mediacodecdec_common.c b/libavcodec/mediacodecdec_common.c
index b1c67c73e3..86ac1135b2 100644
--- a/libavcodec/mediacodecdec_common.c
+++ b/libavcodec/mediacodecdec_common.c
@@ -251,143 +251,96 @@ static void ff_mediacodec_dec_ref(MediaCodecDecContext *s)
 }
 
 /*
- * 进程级的 MediaCodec 复用池。
+ * 进程级的解码器选型缓存。
  *
- * 换台时解码器会被销毁重建，但渲染出来的 Surface 往往不变（mpv 的 vo 与
- * AImageReader 在换台时保持存活）。MediaCodec 实例允许 stop() 后重新 configure()，
- * 复用它可以省掉创建实例与查询解码器能力的开销。只在编码名与 Surface 都相同时复用：
- * 分辨率变化后重新 configure 未必比重建快，还可能踩到厂商实现的问题。
+ * 换台时真正贵的是 ff_AMediaCodecList_getCodecNameByType()：它要在 JNI 里把所有
+ * MediaCodecInfo 逐个翻一遍（名字、支持的 MIME、profile 等级、是否 software-only），
+ * 拿 Haswell 级别的盒子跑一次是毫秒级。而 MediaCodec 实例本身创建很便宜。
+ *
+ * 所以这里只缓存「这个 (mime, profile) 该选哪个解码器」，实例每次新建。绝不跨会话
+ * 搬实例：实例身上挂着输入输出缓冲、Surface 绑定、AImageReader 图像槽位和厂商内部
+ * 状态，一个解不出帧的源会把这些一起带进下一个会话，之后所有源都解不出来。
  */
-#define MC_POOL_CAPACITY 2
+#define MC_CACHE_CAPACITY 8
 
-typedef struct MediaCodecPoolEntry {
+typedef struct MediaCodecNameCacheEntry {
+    char *mime;
+    int profile;
     char *codec_name;
-    FFANativeWindow *surface;   /* 自持一份 surface 引用，保证键里的 Surface 不被释放 */
-    FFAMediaCodec *codec;
-    struct MediaCodecPoolEntry *next;
-} MediaCodecPoolEntry;
+    struct MediaCodecNameCacheEntry *next;
+} MediaCodecNameCacheEntry;
 
-static MediaCodecPoolEntry *mc_pool;
-static int mc_pool_count;
-static AVMutex mc_pool_mutex = AV_MUTEX_INITIALIZER;
-
-static void mediacodec_pool_entry_destroy(MediaCodecPoolEntry *entry);
+static MediaCodecNameCacheEntry *mc_cache;
+static int mc_cache_count;
+static AVMutex mc_cache_mutex = AV_MUTEX_INITIALIZER;
 
 /*
- * 清空复用池。软解/硬解切换、以及组件或内核重启后不应该沿用旧的硬解实例：
- * 旧池里的实例来自另一套解码配置，复用只会把状态问题带过去。
+ * 清空选型缓存。软解/硬解切换、组件升级或内核重启后不该继续沿用旧结论：
+ * 编解码器列表可能已经变了（组件换了一套 .so，系统侧也可能装了新的）。
  */
 void ff_mediacodec_dec_clear_reuse_pool(void)
 {
-    MediaCodecPoolEntry *evict;
+    MediaCodecNameCacheEntry *evict;
 
-    ff_mutex_lock(&mc_pool_mutex);
-    evict = mc_pool;
-    mc_pool = NULL;
-    mc_pool_count = 0;
-    ff_mutex_unlock(&mc_pool_mutex);
+    ff_mutex_lock(&mc_cache_mutex);
+    evict = mc_cache;
+    mc_cache = NULL;
+    mc_cache_count = 0;
+    ff_mutex_unlock(&mc_cache_mutex);
 
     while (evict) {
-        MediaCodecPoolEntry *next = evict->next;
-        mediacodec_pool_entry_destroy(evict);
+        MediaCodecNameCacheEntry *next = evict->next;
+        av_freep(&evict->mime);
+        av_freep(&evict->codec_name);
+        av_free(evict);
         evict = next;
     }
 }
 
-static void mediacodec_pool_entry_destroy(MediaCodecPoolEntry *entry)
-{
-    if (!entry)
-        return;
-
-    if (entry->codec)
-        ff_AMediaCodec_delete(entry->codec);
-    if (entry->surface)
-        ff_mediacodec_surface_unref(entry->surface, NULL);
-    av_freep(&entry->codec_name);
-    av_free(entry);
-}
-
-static int mediacodec_pool_same_surface(const FFANativeWindow *a, const FFANativeWindow *b)
-{
-    return a && b && a->surface == b->surface && a->native_window == b->native_window;
-}
-
-/* 池里保存的是 Surface 的强引用；否则旧播放器释放后这个指针就成了悬空值。 */
-static FFANativeWindow *mediacodec_pool_ref_surface(FFANativeWindow *surface)
+/* 命中返回一份 strdup 出来的名字（调用方按 s->codec_name 自由释放），未命中返回 NULL。 */
+static char *mediacodec_cache_get_codec_name(const char *mime, int profile)
 {
-    if (!surface)
-        return NULL;
-    return ff_mediacodec_surface_ref(surface->surface, surface->native_window, NULL);
-}
+    MediaCodecNameCacheEntry *entry;
+    char *name = NULL;
 
-/* 取回一个已停止的实例，同时带着它的 codec_name；调用方负责最终释放。 */
-static FFAMediaCodec *mediacodec_pool_take_codec(const char *codec_name,
-                                                 FFANativeWindow *surface,
-                                                 void *log_ctx)
-{
-    FFAMediaCodec *found = NULL;
-    MediaCodecPoolEntry *prev = NULL;
-
-    ff_mutex_lock(&mc_pool_mutex);
-    MediaCodecPoolEntry *entry = mc_pool;
-    while (entry) {
-        if (!strcmp(entry->codec_name, codec_name) &&
-            mediacodec_pool_same_surface(entry->surface, surface)) {
-            MediaCodecPoolEntry *next = entry->next;
-            if (prev)
-                prev->next = next;
-            else
-                mc_pool = next;
-            mc_pool_count--;
-            found = entry->codec;
-            entry->codec = NULL;
-            av_log(log_ctx, AV_LOG_DEBUG, "Reusing MediaCodec %p (%s)\n",
-                   found, codec_name);
+    ff_mutex_lock(&mc_cache_mutex);
+    for (entry = mc_cache; entry; entry = entry->next) {
+        if (entry->profile == profile && !strcmp(entry->mime, mime)) {
+            name = av_strdup(entry->codec_name);
             break;
         }
-        prev = entry;
-        entry = entry->next;
     }
-    ff_mutex_unlock(&mc_pool_mutex);
+    ff_mutex_unlock(&mc_cache_mutex);
 
-    if (found && entry)
-        mediacodec_pool_entry_destroy(entry);
-
-    return found;
+    return name;
 }
 
-/*
- * 把已 stop 的实例挂进池；池满时淘汰最旧的一条。
- * 返回 1 表示池接管了这个实例，返回 0 表示没有接手，调用方仍然要负责释放。
- */
-static int mediacodec_pool_put_codec(FFAMediaCodec *codec, const char *codec_name,
-                                     FFANativeWindow *surface, void *log_ctx)
+static void mediacodec_cache_put_codec_name(const char *mime, int profile, const char *codec_name)
 {
-    MediaCodecPoolEntry *entry;
-    MediaCodecPoolEntry *evict = NULL;
+    MediaCodecNameCacheEntry *entry;
+    MediaCodecNameCacheEntry *evict = NULL;
 
-    if (!codec || !codec_name || !surface)
-        return 0;
+    if (!mime || !codec_name)
+        return;
 
     entry = av_mallocz(sizeof(*entry));
     if (!entry)
-        return 0;
+        return;
 
+    entry->mime = av_strdup(mime);
     entry->codec_name = av_strdup(codec_name);
-    entry->surface = mediacodec_pool_ref_surface(surface);
-    entry->codec = codec;
-    if (!entry->codec_name || !entry->surface) {
+    entry->profile = profile;
+    if (!entry->mime || !entry->codec_name) {
+        av_freep(&entry->mime);
         av_freep(&entry->codec_name);
-        if (entry->surface)
-            ff_mediacodec_surface_unref(entry->surface, log_ctx);
         av_free(entry);
-        return 0;
+        return;
     }
 
-    ff_mutex_lock(&mc_pool_mutex);
-    if (mc_pool_count >= MC_POOL_CAPACITY) {
-        MediaCodecPoolEntry *prev = NULL;
-        evict = mc_pool;
+    ff_mutex_lock(&mc_cache_mutex);
+    if (mc_cache_count >= MC_CACHE_CAPACITY) {
+        MediaCodecNameCacheEntry *prev = NULL;
+        evict = mc_cache;
         while (evict && evict->next) {
             prev = evict;
             evict = evict->next;
@@ -396,19 +349,20 @@ static int mediacodec_pool_put_codec(FFAMediaCodec *codec, const char *codec_nam
             if (prev)
                 prev->next = NULL;
             else
-                mc_pool = NULL;
-            mc_pool_count--;
+                mc_cache = NULL;
+            mc_cache_count--;
         }
     }
-    entry->next = mc_pool;
-    mc_pool = entry;
-    mc_pool_count++;
-    ff_mutex_unlock(&mc_pool_mutex);
-
-    if (evict)
-        mediacodec_pool_entry_destroy(evict);
-
-    return 1;
+    entry->next = mc_cache;
+    mc_cache = entry;
+    mc_cache_count++;
+    ff_mutex_unlock(&mc_cache_mutex);
+
+    if (evict) {
+        av_freep(&evict->mime);
+        av_freep(&evict->codec_name);
+        av_free(evict);
+    }
 }
 
 static void ff_mediacodec_dec_unref(MediaCodecDecContext *s)
@@ -903,10 +857,11 @@ static int mediacodec_dec_flush_codec(AVCodecContext *avctx, MediaCodecDecContex
 }
 
 static int mediacodec_dec_get_video_codec(AVCodecContext *avctx, MediaCodecDecContext *s,
-                                          const char *mime, FFAMediaFormat *format,
-                                          int *codec_reused)
+                                          const char *mime, FFAMediaFormat *format)
 {
     int profile;
+    int from_cache = 0;
+    int queried_with_profile;
 
     enum AVPixelFormat pix_fmt;
     static const enum AVPixelFormat pix_fmts[] = {
@@ -940,32 +895,45 @@ static int mediacodec_dec_get_video_codec(AVCodecContext *avctx, MediaCodecDecCo
         av_log(avctx, AV_LOG_WARNING, "Unsupported or unknown profile\n");
     }
 
-    s->codec_name = ff_AMediaCodecList_getCodecNameByType(mime, profile, 0, avctx);
-    if (!s->codec_name && (avctx->hwaccel_flags & AV_HWACCEL_FLAG_ALLOW_PROFILE_MISMATCH)) {
-        profile = -1;
+    /* 缓存键必须用「实际查询时用的 profile」：按 profile 查不到时会退回 -1 再查一次。 */
+    queried_with_profile = profile;
+    s->codec_name = mediacodec_cache_get_codec_name(mime, profile);
+    if (s->codec_name) {
+        from_cache = 1;
+        av_log(avctx, AV_LOG_DEBUG, "Found cached decoder %s\n", s->codec_name);
+    } else {
         s->codec_name = ff_AMediaCodecList_getCodecNameByType(mime, profile, 0, avctx);
-    }
-    if (!s->codec_name) {
-        av_log(avctx, AV_LOG_INFO, "Failed to getCodecNameByType(%s, %d)\n", mime, profile);
-        // getCodecNameByType() can fail due to missing JVM, while NDK
-        // mediacodec can be used without JVM.
-        if (!s->use_ndk_codec) {
-            return AVERROR_EXTERNAL;
+        if (!s->codec_name && (avctx->hwaccel_flags & AV_HWACCEL_FLAG_ALLOW_PROFILE_MISMATCH)) {
+            queried_with_profile = -1;
+            s->codec_name = ff_AMediaCodecList_getCodecNameByType(mime, -1, 0, avctx);
+        }
+        if (!s->codec_name) {
+            av_log(avctx, AV_LOG_INFO, "Failed to getCodecNameByType(%s, %d)\n", mime, profile);
+            // getCodecNameByType() can fail due to missing JVM, while NDK
+            // mediacodec can be used without JVM.
+            if (!s->use_ndk_codec) {
+                return AVERROR_EXTERNAL;
+            }
+        } else {
+            av_log(avctx, AV_LOG_DEBUG, "Found decoder %s\n", s->codec_name);
+            mediacodec_cache_put_codec_name(mime, queried_with_profile, s->codec_name);
         }
-    } else {
-        av_log(avctx, AV_LOG_DEBUG, "Found decoder %s\n", s->codec_name);
-    }
-
-    /* 先看能不能捡回一个刚 stop 的同编码、同 Surface 实例，省掉创建与能力查询。 */
-    if (s->codec_name && s->surface) {
-        s->codec = mediacodec_pool_take_codec(s->codec_name, s->surface, avctx);
-        if (s->codec && codec_reused)
-            *codec_reused = 1;
     }
 
     if (s->codec_name) {
-        if (!s->codec)
-            s->codec = ff_AMediaCodec_createCodecByName(s->codec_name, s->use_ndk_codec);
+        s->codec = ff_AMediaCodec_createCodecByName(s->codec_name, s->use_ndk_codec);
+        /* 缓存的名字可能已经失效（组件换了一套 .so、系统装了新解码器），丢掉重查一次。 */
+        if (!s->codec && from_cache) {
+            av_log(avctx, AV_LOG_WARNING, "Cached decoder %s cannot be created, re-querying\n",
+                   s->codec_name);
+            av_freep(&s->codec_name);
+            ff_mediacodec_dec_clear_reuse_pool();
+            s->codec_name = ff_AMediaCodecList_getCodecNameByType(mime, profile, 0, avctx);
+            if (s->codec_name) {
+                mediacodec_cache_put_codec_name(mime, profile, s->codec_name);
+                s->codec = ff_AMediaCodec_createCodecByName(s->codec_name, s->use_ndk_codec);
+            }
+        }
     } else {
         if (s->codec) {
             s->codec_name = ff_AMediaCodec_getName(s->codec);
@@ -1011,36 +979,17 @@ int ff_mediacodec_dec_init(AVCodecContext *avctx, MediaCodecDecContext *s,
     atomic_init(&s->hw_buffer_count, 0);
     atomic_init(&s->serial, 1);
     s->current_input_buffer = -1;
-    int reused = 0;
 
     if (avctx->codec_type == AVMEDIA_TYPE_AUDIO)
         ret = mediacodec_dec_get_audio_codec(avctx, s, mime, format);
     else if (avctx->codec_type == AVMEDIA_TYPE_VIDEO)
-        ret = mediacodec_dec_get_video_codec(avctx, s, mime, format, &reused);
+        ret = mediacodec_dec_get_video_codec(avctx, s, mime, format);
     else
         av_assert0(0);
     if (ret < 0)
         goto fail;
 
     status = ff_AMediaCodec_configure(s->codec, format, s->surface, NULL, 0);
-    if (status < 0 && reused) {
-        /*
-         * 复用的实例 configure 失败（部分厂商实现不支持跨会话复用），丢掉它换新建实例。
-         * 不能让池里的实例把本次起播直接拖死。
-         */
-        av_log(avctx, AV_LOG_WARNING, "Reused MediaCodec failed to configure, creating a new one\n");
-        ff_AMediaCodec_delete(s->codec);
-        av_freep(&s->codec_name);
-        s->codec = NULL;
-        reused = 0;
-        if (avctx->codec_type == AVMEDIA_TYPE_VIDEO)
-            ret = mediacodec_dec_get_video_codec(avctx, s, mime, format, NULL);
-        else
-            ret = mediacodec_dec_get_audio_codec(avctx, s, mime, format);
-        if (ret < 0)
-            goto fail;
-        status = ff_AMediaCodec_configure(s->codec, format, s->surface, NULL, 0);
-    }
     if (status < 0) {
         char *desc = ff_AMediaFormat_toString(format);
         av_log(avctx, AV_LOG_ERROR,
@@ -1053,22 +1002,6 @@ int ff_mediacodec_dec_init(AVCodecContext *avctx, MediaCodecDecContext *s,
     }
 
     status = ff_AMediaCodec_start(s->codec);
-    if (status < 0 && reused) {
-        av_log(avctx, AV_LOG_WARNING, "Reused MediaCodec failed to start, creating a new one\n");
-        ff_AMediaCodec_delete(s->codec);
-        av_freep(&s->codec_name);
-        s->codec = NULL;
-        reused = 0;
-        if (avctx->codec_type == AVMEDIA_TYPE_VIDEO)
-            ret = mediacodec_dec_get_video_codec(avctx, s, mime, format, NULL);
-        else
-            ret = mediacodec_dec_get_audio_codec(avctx, s, mime, format);
-        if (ret < 0)
-            goto fail;
-        status = ff_AMediaCodec_configure(s->codec, format, s->surface, NULL, 0);
-        if (status >= 0)
-            status = ff_AMediaCodec_start(s->codec);
-    }
     if (status < 0) {
         char *desc = ff_AMediaFormat_toString(format);
         av_log(avctx, AV_LOG_ERROR,
@@ -1307,37 +1240,16 @@ static int mediacodec_dec_receive_inner(AVCodecContext *avctx, MediaCodecDecCont
     return AVERROR(EAGAIN);
 }
 
-/*
- * 走到这里的 fatal 错误说明 MediaCodec 实例本身处于坏状态（典型是解不了的源把它
- * 推进 error 状态）。这样的实例不能进复用池，否则下一个频道拿到它必定也解不出来。
- * EAGAIN / EOF 是正常流程信号，不算。
- */
-static void mediacodec_note_error(AVCodecContext *avctx, MediaCodecDecContext *s, int ret)
-{
-    if (ret < 0 && ret != AVERROR(EAGAIN) && ret != AVERROR_EOF) {
-        if (!s->unusable) {
-            av_log(avctx, AV_LOG_WARNING,
-                   "MediaCodec %p hit a fatal error (%d), excluding it from the reuse pool\n",
-                   s->codec, ret);
-        }
-        s->unusable = 1;
-    }
-}
-
 int ff_mediacodec_dec_send(AVCodecContext *avctx, MediaCodecDecContext *s,
                            AVPacket *pkt, bool wait)
 {
-    int ret = mediacodec_dec_send_inner(avctx, s, pkt, wait);
-    mediacodec_note_error(avctx, s, ret);
-    return ret;
+    return mediacodec_dec_send_inner(avctx, s, pkt, wait);
 }
 
 int ff_mediacodec_dec_receive(AVCodecContext *avctx, MediaCodecDecContext *s,
                               AVFrame *frame, bool wait)
 {
-    int ret = mediacodec_dec_receive_inner(avctx, s, frame, wait);
-    mediacodec_note_error(avctx, s, ret);
-    return ret;
+    return mediacodec_dec_receive_inner(avctx, s, frame, wait);
 }
 
 /*
@@ -1359,11 +1271,8 @@ int ff_mediacodec_dec_flush(AVCodecContext *avctx, MediaCodecDecContext *s)
 
         /* No frames (holding a reference to the codec) are retained by the
          * user, thus we can flush the codec and returns accordingly */
-        if ((ret = mediacodec_dec_flush_codec(avctx, s)) < 0) {
-            /* flush 都失败说明实例已经不可用，不能再回池 */
-            s->unusable = 1;
+        if ((ret = mediacodec_dec_flush_codec(avctx, s)) < 0)
             return ret;
-        }
 
         return 1;
     }
@@ -1378,14 +1287,10 @@ int ff_mediacodec_dec_close(AVCodecContext *avctx, MediaCodecDecContext *s)
         return 0;
 
     /*
-     * 只有视频、且没有待返回的硬件缓冲、也没有别的引用（用户还持有 frame）时才能入池。
-     * 池拿走 codec 之后必须把它从 context 上摘掉，否则 unref 会把同一个实例删掉两次。
+     * 解不出来的源会把解码器实例本身弄坏：有的设备上 configure/start 全成功，
+     * 喂进去的包全被吞掉，一帧都不出，也不报错。所以实例一律当次用完即删，
+     * 绝不跨会话复用——只缓存「该选哪个解码器」，实例本身每次新建。
      */
-    int poolable = avctx && avctx->codec_type == AVMEDIA_TYPE_VIDEO && s->codec &&
-                   s->codec_name && s->surface && !s->unusable &&
-                   atomic_load(&s->hw_buffer_count) == 0 &&
-                   atomic_load(&s->refcount) == 1;
-
     if (s->codec) {
         if (atomic_load(&s->hw_buffer_count) == 0) {
             ff_AMediaCodec_stop(s->codec);
@@ -1395,11 +1300,6 @@ int ff_mediacodec_dec_close(AVCodecContext *avctx, MediaCodecDecContext *s)
         }
     }
 
-    if (poolable && mediacodec_pool_put_codec(s->codec, s->codec_name, s->surface, avctx)) {
-        /* 池自己 strdup 了一份名字，这里必须摘掉 codec，否则 unref 会再删一次。 */
-        s->codec = NULL;
-    }
-
     ff_mediacodec_dec_unref(s);
 
     return 0;
diff --git a/libavcodec/mediacodecdec_common.h b/libavcodec/mediacodecdec_common.h
index b41497525b..479e75ad89 100644
